# ====== 应用基础配置 ======
APP_NAME=RAG Knowledge Base System
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ====== 数据库配置 ======
# 本地开发 (SQLite, 无需 Docker)
DATABASE_URL=sqlite:///./data/rag_system.db
DATABASE_SYNC_URL=sqlite:///./data/rag_system.db

# PostgreSQL (Docker Compose 启动后切换为此配置)
# DATABASE_URL=postgresql+asyncpg://rag_user:rag_dev_password@localhost:5432/rag_system
# DATABASE_SYNC_URL=postgresql+psycopg2://rag_user:rag_dev_password@localhost:5432/rag_system

# 连接池 (PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ====== Redis ======
REDIS_URL=redis://localhost:6379/0

# ====== 安全配置 ======
SECRET_KEY=change-this-in-production-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ====== LLM 配置 ======
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# ====== Embedding ======
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DEFAULT_DIM=384

# ====== RAG ======
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=3000

# ====== 文件存储 ======
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_stores

# ====== CORS ======
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
